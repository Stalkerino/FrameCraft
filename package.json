{
  "name": "framecraft-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/test-e2e-ci.mjs",
    "test:e2e:gpu": "node scripts/test-gpu.mjs",
    "test:gpu:native": "node scripts/test-native-gpu.mjs",
    "setup:gpu": "node scripts/install/vulkan.mjs",
    "mcp": "node scripts/mcp.mjs",
    "doctor": "node --import tsx scripts/doctor.ts",
    "docs:screenshots": "node --import tsx scripts/capture-docs.mjs",
    "setup": "node scripts/install/setup.mjs",
    "launch": "node scripts/install/launch.mjs",
    "desktop:dev": "npm run build && node scripts/desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/start-desktop.mjs",
    "desktop:check": "node scripts/desktop-smoke.mjs",
    "desktop:setup": "node scripts/install/desktop.mjs",
    "web:setup": "node scripts/web/setup.mjs",
    "web:launch": "node scripts/web/launch.mjs",
    "desktop:release": "node scripts/release/build.mjs",
    "release:smoke": "node scripts/release/smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@remotion/bundler": "4.0.522",
    "@remotion/player": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "@tauri-apps/api": "^2.11.1",
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.522",
    "sharp": "0.34.5",
    "tsx": "^4.20.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "license": "GPL-3.0-or-later"
}
